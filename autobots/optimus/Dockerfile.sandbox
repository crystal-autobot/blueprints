# Sandbox image for autobot Docker execution.
# Customize this file to add tools your bot needs.
# Rebuild with: docker build -t autobot-sandbox -f Dockerfile.sandbox .
FROM alpine:latest

RUN apk add --no-cache \
    python3 \
    py3-pillow \
    font-dejavu \
    curl \
    sqlite \
    git \
    github-cli
