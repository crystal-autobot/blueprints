# Sandbox image for Bumblebee training bot.
# Includes Python with matplotlib for generating training charts.
# Rebuild with: docker build -t bumblebee-sandbox -f Dockerfile.sandbox .
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    matplotlib \
    pandas
