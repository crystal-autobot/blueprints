# Required
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional: Anthropic (if the anthropic model is enabled)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: faster transcription (also uncomment the groq provider in config.yml)
GROQ_API_KEY=

# Optional: Web search
BRAVE_API_KEY=

# Optional: Notion sync (https://www.notion.so/profile/integrations)
NOTION_TOKEN=ntn_...

# Optional: local timezone for note dates (default: UTC)
TZ=Europe/Berlin
